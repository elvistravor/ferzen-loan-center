# Configure these in Netlify Site configuration > Environment variables.
# Never commit real values. Use the Supabase secret/service-role key server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY
SETUP_KEY=REPLACE_WITH_A_LONG_RANDOM_ONE_TIME_SETUP_KEY
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
